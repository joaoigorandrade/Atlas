      }
    },
    "Você se avalia em %lld%% e entrega %lld%%. Sabe mais do que acha; pode acelerar aqui.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You rate yourself %lld%% and deliver %lld%%. You know more than you think; you can speed up here."
