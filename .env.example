# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.

# Required — your OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — model slug used for all content generation.
# Default: deepseek/deepseek-chat (OpenRouter's alias for DeepSeek's latest V3
# flagship chat model — cheap and reliably structured).
# Other cheap models that handle this app's JSON well:
#   deepseek/deepseek-chat-v3.1   (pin a specific DeepSeek version)
#   openai/gpt-4o-mini
#   google/gemini-2.0-flash-001
#   google/gemini-2.5-flash-lite
OPENROUTER_MODEL=deepseek/deepseek-chat

# Optional — stronger model for answer judging (Socratic/Feynman/Crucible).
# Judging demands more reliability than content generation; defaults to
# OPENROUTER_MODEL when unset.
# OPENROUTER_JUDGE_MODEL=anthropic/claude-sonnet-4.5

# Optional — comma-separated fallback model chain, tried in order after the
# primary model's retries (429/5xx with backoff) exhaust.
# OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini,google/gemini-2.0-flash-001

# Optional — override the API base URL (tests / self-hosted gateways).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Generation is capped per learner per UTC day (counted from generation_log via
# generation_jobs_today()); over the cap /api/generate answers 429. There is
# still no global monthly spend ceiling and no output-token cap on model calls.
# GENERATION_DAILY_QUOTA=60          # distinct jobs per learner per UTC day; 0 disables

# Optional — server-side warm depth.
# CURRICULUM_WARM_NODES=3            # frontier nodes warmed server-side behind a
#                                    # finished build, so the first click is a hit

# Optional — bump to invalidate every cached generation after a prompt change.
# Old rows simply stop being addressed; nothing needs deleting.
# CONTENT_CACHE_VERSION=1

# Read-aloud (text-to-speech) — the Speechify API.
# Without SPEECHIFY_API_KEY read-aloud is simply not offered: the speaker
# control never renders and the Settings toggle is disabled with a note. There
# is deliberately no fallback to the browser's own `speechSynthesis` — one
# engine, or none, so voice quality never depends on which browser a learner
# happens to be in.
#
# Picked on budget with integration cost counted. Google Cloud and Polly are
# cheaper per character ($4/M) but need request signing — a crypto dependency
# and a private key file — while this is the cheapest engine reachable with a
# plain bearer token ($6-10/M, against Azure's $16 and ElevenLabs' $60-100).
# The free tier is 50k characters a month as a HARD CAP with no overage, which
# is the budget risk that actually matters. Get a key at https://speechify.ai/.
#
# Synthesized audio is cached in `speech_cache` and shared across users the way
# generated content is, so a section is paid for once no matter how many
# learners read it.
# SPEECHIFY_API_KEY=

# Optional — voice slug. Defaults to "henry", a mid-register voice that carries
# both locales. The voice follows the language setting; it is never a second
# choice the learner has to make.
# SPEECHIFY_VOICE_ID=henry

# Optional — override the per-language model choice. Defaults to
# simba-english for en and simba-multilingual for pt-BR (non-English synthesis
# needs the multilingual model).
# SPEECHIFY_MODEL=

# Optional — override the API base URL (tests / self-hosted gateways).
# SPEECHIFY_BASE_URL=https://api.sws.speechify.com

# Optional — bump to abandon every cached clip after a voice or provider
# change. Separate from CONTENT_CACHE_VERSION on purpose: audio for prose that
# didn't change must not be discarded, and re-billed, because a prompt was
# reworded.
# SPEECH_CACHE_VERSION=1

# Supabase — auth (magic-link accounts) + run-state persistence.
# Find these under the project's Settings → API Keys. next.config.ts mirrors
# URL + publishable key into NEXT_PUBLIC_* for the browser bundle; RLS is the
# access control, so both are safe client-side.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only — used for account deletion (#33), the reminders cron (#31), and
# the shared generated-content cache, all of which cross user boundaries. Never
# exposed to the browser. Without it the app still works, but every screen
# entry re-generates its content instead of reading it back.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=

# Reminders cron (#31), all optional.
# CRON_SECRET       — Vercel Cron sends it as a Bearer token; set it to lock the route.
# RESEND_API_KEY    — enables actual email sends; without it reminders are logged only.
# REMINDER_FROM     — verified sender, e.g. "Atlas <hi@yourdomain>".
# APP_URL           — absolute app URL used in the reminder link.
# CRON_SECRET=
# RESEND_API_KEY=
# REMINDER_FROM=
# APP_URL=https://your-atlas.vercel.app
